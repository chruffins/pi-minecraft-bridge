# Minecraft Java server reachable from the computer running Pi
MC_HOST=192.168.1.50
MC_PORT=25565
MC_USERNAME=PiChatBridge
# Optional: Microsoft account auth (offline servers can omit this)
# MC_AUTH=microsoft
# Only forward chat messages beginning with this prefix to Pi. Empty means all chat.
MC_PREFIX=!pi
# Prefix Pi's in-game replies with this label.
MC_REPLY_PREFIX=[Pi]
